<Window x:Class="GoldbergGUI.WPF.Views.ControllerDetectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:GoldbergGUI.Core.Utils;assembly=GoldbergGUI.Core"
        Title="Edit Binding"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- current binding chips list -->
            <RowDefinition Height="Auto"/>  <!-- "Add from list" row -->
            <RowDefinition Height="Auto"/>  <!-- detect-from-controller row -->
            <RowDefinition Height="Auto"/>  <!-- disambiguation panel -->
            <RowDefinition Height="Auto"/>  <!-- OK / Cancel -->
        </Grid.RowDefinitions>

        <!-- ── Current binding parts ──────────────────────────────────────── -->
        <GroupBox Grid.Row="0"
                  Header="Current bindings"
                  Foreground="{DynamicResource ForegroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  Margin="0,0,0,10">
            <StackPanel>
                <!-- Empty-state hint -->
                <TextBlock x:Name="EmptyHint"
                           Text="(no bindings — add one below)"
                           FontStyle="Italic"
                           Opacity="0.55"
                           Margin="4,6,4,6"
                           Foreground="{DynamicResource ForegroundBrush}"/>

                <!-- Live chip list -->
                <ItemsControl x:Name="PartsList"
                              Margin="0,2,0,2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,2,2,2">
                                <Button DockPanel.Dock="Right"
                                        Content="✕"
                                        Width="24" Height="24"
                                        Padding="0"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Tag="{Binding}"
                                        Click="RemovePart_Click"
                                        ToolTip="Remove this binding"/>
                                <TextBlock Text="{Binding FriendlyName}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           Margin="4,0,6,0"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </GroupBox>

        <!-- ── Add from list ──────────────────────────────────────────────── -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right"
                    x:Name="AddListBtn"
                    Content="Add ▶"
                    Width="60"
                    Margin="6,0,0,0"
                    Click="AddFromList_Click"
                    ToolTip="Add the selected binding to the list"/>
            <ComboBox x:Name="PickerCombo"
                      ItemsSource="{x:Static utils:ControllerBindingMap.AllOptions}"
                      DisplayMemberPath="FriendlyName"
                      MaxDropDownHeight="180"
                      SelectedIndex="0"/>
        </DockPanel>

        <!-- ── Detect from controller ─────────────────────────────────────── -->
        <DockPanel Grid.Row="2" Margin="0,0,0,0">
            <Button DockPanel.Dock="Right"
                    x:Name="DetectBtn"
                    Content="🎮 Detect"
                    Width="80"
                    Margin="6,0,0,0"
                    Click="Detect_Click"
                    ToolTip="Press a button / move a stick on your controller to add it"/>
            <TextBlock x:Name="DetectStatusText"
                       Text="Press a physical input to detect it automatically."
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="12"/>
        </DockPanel>

        <!-- ── Disambiguation panel ───────────────────────────────────────── -->
        <StackPanel x:Name="DisambigPanel"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button x:Name="DirectionBtn"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Click="DirectionBtn_Click"
                    ToolTip="Bind to this specific direction (digital on/off)"/>
            <Button x:Name="AnalogBtn"
                    Padding="10,6"
                    Click="AnalogBtn_Click"
                    ToolTip="Bind to the full analog axis of this stick"/>
        </StackPanel>

        <!-- ── Accept / Cancel ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0">
            <Button x:Name="AcceptButton"
                    Content="OK"
                    Width="80"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Accept_Click"/>
            <Button Content="Cancel"
                    Width="80"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
